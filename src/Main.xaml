<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
  <Border x:Name="BaseLayer" Background="{DynamicResource BaseFill}"/>
  <Rectangle x:Name="GradLayer" IsHitTestVisible="False"/>
  <Grid x:Name="Layout" Margin="10,0,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="160"/>
      <RowDefinition Height="8"/>
      <RowDefinition x:Name="HistRow" Height="190" MinHeight="70"/>
    </Grid.RowDefinitions>

    <!-- title bar -->
    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False">
        <Ellipse x:Name="TitleDot" Width="10" Height="10" Fill="{DynamicResource Accent}" Margin="0,0,9,0"/>
        <TextBlock Text="Agent Watch" FontWeight="SemiBold" FontSize="13.5"/>
        <TextBlock x:Name="TitleStatus" Text="" Foreground="{DynamicResource Dim}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="BtnGear" Style="{StaticResource WinBtn}" ToolTip="Appearance and tests"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button>
        <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" ToolTip="Minimize"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
        <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" ToolTip="Maximize"><TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
        <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" ToolTip="Close to tray"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
      </StackPanel>
    </Grid>

    <!-- header: eyes + live facts -->
    <ContentControl Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
      <Grid>
        <Border x:Name="HeaderGlow" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
        <Grid Margin="10,8,14,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Canvas x:Name="EyeHost" Width="176" Height="82" ClipToBounds="False" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
            <TextBlock x:Name="HeadMain" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Watching for AI agents..."/>
            <TextBlock x:Name="HeadSub" FontSize="12.5" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="56" TextTrimming="CharacterEllipsis"/>
            <WrapPanel x:Name="FactChips" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border x:Name="StatePill" Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="12,4" CornerRadius="12">
              <TextBlock x:Name="StateText" FontWeight="Bold" FontSize="12" Text="IDLE"/>
            </Border>
            <TextBlock x:Name="StateSince" HorizontalAlignment="Right" Foreground="{DynamicResource Dim}" FontSize="11.5" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </ContentControl>

    <!-- toolbar -->
    <WrapPanel Grid.Row="2" Margin="2,0,0,4">
      <CheckBox x:Name="ChkModels" Style="{StaticResource Switch}" Content="Show model servers" VerticalAlignment="Center"/>
      <CheckBox x:Name="ChkHelpers" Style="{StaticResource Switch}" Content="Show console helpers" VerticalAlignment="Center"/>
      <CheckBox x:Name="ChkMcp" Style="{StaticResource Switch}" Content="Show tool servers (MCP)" VerticalAlignment="Center"/>
      <Button x:Name="BtnExpand" Style="{StaticResource Btn}" Content="Expand all" Padding="10,4"/>
      <Button x:Name="BtnCollapse" Style="{StaticResource Btn}" Content="Collapse all" Padding="10,4"/>
      <Button x:Name="BtnLogs" Style="{StaticResource Btn}" Content="Open logs" Padding="10,4"/>
      <Button x:Name="BtnRules" Style="{StaticResource Btn}" Content="Edit explanations" Padding="10,4"/>
    </WrapPanel>

    <!-- body -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="380"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition x:Name="DetCol" Width="400" MinWidth="280"/>
      </Grid.ColumnDefinitions>
      <ContentControl Style="{StaticResource Card}" Padding="8,8,4,6">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="10,0,14,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="60"/><ColumnDefinition Width="54"/><ColumnDefinition Width="62"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource H}" Text="APP / PROCESS"/>
            <TextBlock Style="{StaticResource H}" Grid.Column="1" Text="DOING NOW"/>
            <TextBlock Style="{StaticResource H}" Grid.Column="2" Text="RISK"/>
            <TextBlock Style="{StaticResource H}" Grid.Column="3" Text="PID" HorizontalAlignment="Right"/>
            <TextBlock Style="{StaticResource H}" Grid.Column="4" Text="CPU %" HorizontalAlignment="Right"/>
            <TextBlock Style="{StaticResource H}" Grid.Column="5" Text="RAM MB" HorizontalAlignment="Right"/>
          </Grid>
          <ListBox x:Name="Rows" Grid.Row="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="{Binding RowH}" Margin="10,0,4,0" Background="Transparent" ToolTip="{Binding Tip}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="60"/><ColumnDefinition Width="54"/><ColumnDefinition Width="62"/>
                  </Grid.ColumnDefinitions>
                  <DockPanel VerticalAlignment="Center" LastChildFill="True" ClipToBounds="True" Margin="0,0,10,0">
                    <Border DockPanel.Dock="Left" Width="{Binding IndentW}"/>
                    <Border DockPanel.Dock="Left" Tag="exp" Width="22" Height="22" CornerRadius="5" Background="#01FFFFFF" Cursor="Hand">
                      <TextBlock Tag="exp" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                    </Border>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" Margin="2,0,8,0" Visibility="{Binding DotVis}"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="{Binding Weight}" FontSize="{Binding NameSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource Dim}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Doing}" Foreground="{Binding DoingFore}" FontWeight="{Binding DoingWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                  <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding PillBack}">
                    <TextBlock Text="{Binding Pill}" Foreground="{Binding PillFore}" FontSize="11" FontWeight="Bold"/>
                  </Border>
                  <TextBlock Grid.Column="3" Text="{Binding Pid}" Foreground="{DynamicResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding Cpu}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding Ram}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ContentControl>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
      <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <ScrollViewer x:Name="DetScroll" VerticalScrollBarVisibility="Auto" Padding="16,14,10,14">
          <StackPanel x:Name="Det"/>
        </ScrollViewer>
      </ContentControl>
    </Grid>

    <GridSplitter Grid.Row="4" Style="{StaticResource HSplit}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

    <!-- history -->
    <ContentControl Grid.Row="5" Style="{StaticResource Card}" Padding="8,6,4,6">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="10,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/><ColumnDefinition Width="86"/><ColumnDefinition Width="170"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource H}" Text="HISTORY - WHEN"/>
          <TextBlock Style="{StaticResource H}" Grid.Column="1" Text="UNTIL"/>
          <TextBlock Style="{StaticResource H}" Grid.Column="2" Text="WHO"/>
          <TextBlock Style="{StaticResource H}" Grid.Column="3" Text="WHAT HAPPENED"/>
          <TextBlock Style="{StaticResource H}" Grid.Column="4" Text="PROCESS / DETAIL"/>
        </Grid>
        <ListBox x:Name="Hist" Grid.Row="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="28" Margin="10,0,4,0" Background="Transparent" ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/><ColumnDefinition Width="86"/><ColumnDefinition Width="170"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                <TextBlock Grid.Column="1" Text="{Binding Sub}" VerticalAlignment="Center" Foreground="{Binding DoingFore}" FontWeight="{Binding Weight}"/>
                <TextBlock Grid.Column="2" Text="{Binding Pill}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding Doing}" VerticalAlignment="Center" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding Cpu}" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </ContentControl>
  </Grid>

  <!-- overlays -->
  <Border x:Name="Scrim" Background="#661E1B4B" Visibility="Collapsed"/>
  <Border x:Name="AppearPanel" Width="380" HorizontalAlignment="Right" Margin="0,44,10,10" Visibility="Collapsed">
    <Border.RenderTransform><TranslateTransform x:Name="AppearShift" X="400"/></Border.RenderTransform>
    <ContentControl Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="16,12,8,4">
          <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="BtnAppearClose" Style="{StaticResource WinBtn}" HorizontalAlignment="Right"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,10,14">
          <StackPanel x:Name="AppearBody"/>
        </ScrollViewer>
      </Grid>
    </ContentControl>
  </Border>

  <Border x:Name="DangerPop" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" CornerRadius="16" BorderThickness="2" BorderBrush="#FFFB7185" Background="#F24C0519" Padding="22,18">
    <Border.Effect><DropShadowEffect x:Name="DangerShadow" Color="#FFF43F5E" BlurRadius="40" ShadowDepth="0" Opacity="0.85"/></Border.Effect>
    <StackPanel x:Name="DangerBody"/>
  </Border>

  <Border x:Name="Confirm" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource PanelStrong}" Padding="22,18">
    <Border.Effect><DropShadowEffect Color="#FF1E1B4B" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
    <StackPanel>
      <TextBlock x:Name="ConfirmTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBox x:Name="ConfirmText" Style="{StaticResource SelText}" Margin="0,10,0,16" Foreground="{DynamicResource Dim}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ConfirmNo" Style="{StaticResource Btn}" Content="Cancel" Padding="18,7"/>
        <Button x:Name="ConfirmYes" Style="{StaticResource DangerBtn}" Content="Yes, kill it" Padding="18,7"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Grid>
